# Copy this file to .env and fill in your key. .env is gitignored.
# Get a free key at https://aistudio.google.com/apikey  (no credit card required)
GEMINI_API_KEY=your-key-here
# (GOOGLE_API_KEY also works if that's what you already have set.)

# Optional. Defaults to gemini-2.5-flash (free tier, fast).
# Other free-tier options: gemini-2.5-flash-lite (higher RPM), gemini-3.5-flash
GEMINI_MODEL=gemini-2.5-flash
